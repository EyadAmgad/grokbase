# ── AI Chat Workspace (src/views/frontend) ─────────────────────────────
# Copy to `.env` and adjust. All keys are optional: with none set, the
# workspace runs in offline mock mode.

# Base API URL. Empty string = same-origin (this is what you want behind the
# FastAPI backend, or via the Vite dev proxy).
VITE_API_URL=""

# Next.js parity — inlined identically when using Next instead of Vite.
NEXT_PUBLIC_API_URL=""

# "rest" (real GrokBase API) | "mock" (offline simulated backend)
VITE_API_MODE=""

# ── GrokBase contract (src/routes/nlp.py) ─────────────────────────────
# Numeric project id used by /api/v1/nlp/index/answer/{project_id}
VITE_PROJECT_ID="1"
# Retrieval limit — how many matching chunks feed the generator
VITE_TOP_K="5"
# The backend has no accounts; the workspace runs as a guest you may name.
VITE_USER_NAME="Guest"
VITE_USER_EMAIL="guest@localhost"

# Stream transport: "json" (shipping backend) | "sse" | "websocket"
# (sse/websocket activate the generic adapter paths for streaming backends)
VITE_STREAM_MODE="json"

# Auth header added to every request: Authorization: Bearer <token>
VITE_AUTH_TOKEN=""

# Endpoint overrides (relative to VITE_API_URL). {project_id} is substituted.
VITE_USER_ENDPOINT="/api/v1/"
VITE_HISTORY_ENDPOINT="/api/v1/chat/history"
VITE_STREAM_ENDPOINT="/api/v1/nlp/index/answer/{project_id}"

# Model parameters forwarded to streaming-capable backends
VITE_MODEL="gpt-4o-mini"
VITE_TEMPERATURE="0.4"
VITE_MAX_TOKENS="2048"

# Dev proxy target for the FastAPI backend (vite.config.ts)
VITE_PROXY_TARGET="http://localhost:8000"
